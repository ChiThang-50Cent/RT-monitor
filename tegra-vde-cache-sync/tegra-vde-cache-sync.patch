+/*
+ * Opt-in for pipelines that hand decoded frames to other devices only
+ * (DMA-BUF scanout/overlay): capture planes are invalidated once, then
+ * per-frame CPU cache maintenance is skipped. CPU readers of MMAP capture
+ * buffers would see stale data, hence off by default.
+ */
+static bool skip_capture_cache_sync;
+module_param(skip_capture_cache_sync, bool, 0444);
+MODULE_PARM_DESC(skip_capture_cache_sync,
+		 "Skip per-frame cache sync of decoded frames (CPU never reads them)");
+
+static unsigned int coded_buffer_min_kb = SZ_2M / SZ_1K;
+module_param(coded_buffer_min_kb, uint, 0444);
+MODULE_PARM_DESC(coded_buffer_min_kb,
+		 "Minimum coded (bitstream) buffer size in KiB (default 2048)");
+
 static const struct v4l2_ctrl_config ctrl_cfgs[] = {
