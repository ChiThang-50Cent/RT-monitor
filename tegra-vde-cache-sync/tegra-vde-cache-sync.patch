+/*
+ * vb2 would clean the whole coded buffer and invalidate every decoded
+ * plane per frame. Clean only the written bitstream bytes (payload plus
+ * the zero padding above) and, if allowed, skip decoded-frame maintenance.
+ */
+static void tegra_buf_sync_cache(struct vb2_buffer *vb)
+{
+	struct vb2_queue *vq = vb->vb2_queue;
+	struct tegra_m2m_buffer *tb = vb_to_tegra_buf(vb);
+	struct scatterlist *sg;
+	struct sg_table *sgt;
+	unsigned int i;
+	size_t len;
+
+	if (V4L2_TYPE_IS_CAPTURE(vq->type)) {
+		if (!skip_capture_cache_sync)
+			return;
+		/* No CPU reads: the post-decode invalidate is never needed. */
+		vb->skip_cache_sync_on_finish = 1;
+		/* Freshly zeroed pages may hold dirty lines; invalidate once. */
+		vb->skip_cache_sync_on_prepare = tb->cpu_cache_clean;
+		tb->cpu_cache_clean = true;
+		return;
+	}
+
+	if (vb->num_planes != 1)
+		return;
+
+	sgt = vb2_dma_sg_plane_desc(vb, 0);
+	/* buf_prepare already extended the payload to the padded HW size. */
+	len = vb->planes[0].data_offset + vb2_get_plane_payload(vb, 0);
+	for_each_sgtable_dma_sg(sgt, sg, i) {
+		size_t chunk = min_t(size_t, len, sg_dma_len(sg));
+
+		dma_sync_single_for_device(vq->dev, sg_dma_address(sg), chunk,
+					   DMA_TO_DEVICE);
+		len -= chunk;
+		if (!len)
+			break;
+	}
+	vb->skip_cache_sync_on_prepare = 1;
+}
