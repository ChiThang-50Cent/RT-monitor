#!/bin/sh
# Surface RT display appliance initramfs
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

rescue_shell() {
    echo "====================================================" >&2
    echo "Surface Appliance Boot Failure: $1" >&2
    echo "Dropping to rescue shell. Never writing to eMMC." >&2
    echo "====================================================" >&2
    while true; do
        /bin/sh -i </dev/console >/dev/console 2>&1 || /bin/sh
    done
}

mount -t proc -o noexec,nosuid,nodev proc /proc || rescue_shell "mount /proc failed"
mount -t sysfs -o noexec,nosuid,nodev sysfs /sys || rescue_shell "mount /sys failed"
mount -t devtmpfs -o nosuid,noexec devtmpfs /dev || rescue_shell "mount /dev failed"

# Load storage / filesystem modules (squashfs, overlay)
for mod in squashfs overlay; do
    modprobe "$mod" 2>/dev/null || true
done
for ko in /lib/modules/*/*/*/*.ko* /lib/modules/*/*/*/*/*.ko*; do
    [ -f "$ko" ] && insmod "$ko" 2>/dev/null || true
done

BOOT_UUID="17C0-8631"
BOOT_DEV=""
TIMEOUT=15

echo "Waiting up to ${TIMEOUT}s for partition UUID=$BOOT_UUID..."
i=0
while [ "$i" -lt "$TIMEOUT" ]; do
    BOOT_DEV=$(blkid -U "$BOOT_UUID" 2>/dev/null || true)
    if [ -z "$BOOT_DEV" ]; then
        BOOT_DEV=$(findfs UUID="$BOOT_UUID" 2>/dev/null || true)
    fi
    if [ -z "$BOOT_DEV" ] && [ -b "/dev/disk/by-uuid/$BOOT_UUID" ]; then
        BOOT_DEV="/dev/disk/by-uuid/$BOOT_UUID"
    fi
    if [ -n "$BOOT_DEV" ] && [ -b "$BOOT_DEV" ]; then
        break
    fi
    sleep 1
    i=$((i + 1))
done

if [ -z "$BOOT_DEV" ] || [ ! -b "$BOOT_DEV" ]; then
    rescue_shell "Timeout waiting for boot partition UUID=$BOOT_UUID"
fi

echo "Mounting boot partition $BOOT_DEV at /media/boot (read-only)..."
mkdir -p /media/boot
if ! mount -t vfat -o ro,noatime,fmask=0077,dmask=0077 "$BOOT_DEV" /media/boot; then
    rescue_shell "Failed to mount boot partition $BOOT_DEV read-only"
fi

RELEASE_ID=""
for opt in $(cat /proc/cmdline); do
    case "$opt" in
        appliance.release=*)
            RELEASE_ID="${opt#appliance.release=}"
            ;;
    esac
done

if [ -z "$RELEASE_ID" ]; then
    rescue_shell "Missing appliance.release=<id> parameter in /proc/cmdline"
fi
case "$RELEASE_ID" in
    *[!a-zA-Z0-9_-]*|"") rescue_shell "Invalid release ID" ;;
esac

RELEASE_DIR="/media/boot/appliance/$RELEASE_ID"
if [ ! -d "$RELEASE_DIR" ]; then
    rescue_shell "Appliance release directory $RELEASE_DIR not found"
fi

verify_hash() {
    actual=$(sha256sum "$1" 2>/dev/null | awk '{print $1}')
    [ "$actual" = "$2" ] || rescue_shell "Checksum mismatch: $1"
}

LOWERS="/ro_squash"
if [ -f "$RELEASE_DIR/release.conf" ]; then
    [ -f /extension-descriptor.sha256 ] || rescue_shell "Extension not authorized by initramfs"
    verify_hash "$RELEASE_DIR/release.conf" "$(cat /extension-descriptor.sha256)"
    FORMAT="" BASE_ID="" BASE_SHA="" EXT_SHA=""
    while IFS='=' read -r key value; do
        case "$key" in
            format) [ -z "$FORMAT" ] || rescue_shell "Duplicate format"; FORMAT="$value" ;;
            base_id) [ -z "$BASE_ID" ] || rescue_shell "Duplicate base_id"; BASE_ID="$value" ;;
            base_sha256) [ -z "$BASE_SHA" ] || rescue_shell "Duplicate base hash"; BASE_SHA="$value" ;;
            extension_sha256) [ -z "$EXT_SHA" ] || rescue_shell "Duplicate extension hash"; EXT_SHA="$value" ;;
            *) rescue_shell "Unknown descriptor key" ;;
        esac
    done < "$RELEASE_DIR/release.conf"
    [ "$FORMAT" = surface-extension-v1 ] || rescue_shell "Invalid extension format"
    [ "$BASE_ID" = 6258b2a5368a ] || rescue_shell "Invalid frozen base"
    [ "$BASE_SHA" = 48e1fb2c68aade6b2ae28faa14482ed332f67bcd27a2a3dc27449d3eae13516f ] || rescue_shell "Invalid frozen base hash"
    [ "${#EXT_SHA}" = 64 ] || rescue_shell "Invalid extension hash length"
    case "$EXT_SHA" in *[!0-9a-f]*) rescue_shell "Invalid extension hash" ;; esac
    BASE_FILE="/media/boot/appliance/$BASE_ID/rootfs.squashfs"
    verify_hash "$BASE_FILE" "$BASE_SHA"
    verify_hash "$RELEASE_DIR/extension.squashfs" "$EXT_SHA"
    mkdir -p /ro_base /ro_extension /overlay_tmpfs /sysroot
    mount -t squashfs -o ro,loop "$BASE_FILE" /ro_base || rescue_shell "Base mount failed"
    mount -t squashfs -o ro,loop "$RELEASE_DIR/extension.squashfs" /ro_extension || rescue_shell "Extension mount failed"
    LOWERS="/ro_extension:/ro_base"
else
    [ ! -f /extension-descriptor.sha256 ] || rescue_shell "Missing authorized extension descriptor"
    SHA_FILE="$RELEASE_DIR/SHA256SUMS"
    SQUASHFS_FILE="$RELEASE_DIR/rootfs.squashfs"
    EXPECTED_SHA=$(awk '$2 == "rootfs.squashfs" {print $1}' "$SHA_FILE")
    [ "${#EXPECTED_SHA}" = 64 ] || rescue_shell "Invalid rootfs checksum entry"
    case "$EXPECTED_SHA" in *[!0-9a-f]*) rescue_shell "Invalid rootfs hash" ;; esac
    verify_hash "$SQUASHFS_FILE" "$EXPECTED_SHA"
    mkdir -p /ro_squash /overlay_tmpfs /sysroot
    mount -t squashfs -o ro,loop "$SQUASHFS_FILE" /ro_squash || rescue_shell "Rootfs mount failed"
fi

echo "Setting up tmpfs overlay..."
if ! mount -t tmpfs -o mode=0755 tmpfs /overlay_tmpfs; then
    rescue_shell "Failed to mount tmpfs for overlay"
fi

mkdir -p /overlay_tmpfs/upper /overlay_tmpfs/work

if ! mount -t overlay overlay -o lowerdir="$LOWERS",upperdir=/overlay_tmpfs/upper,workdir=/overlay_tmpfs/work /sysroot; then
    rescue_shell "Failed to mount overlay on /sysroot"
fi

mkdir -p /sysroot/media/boot
if ! mount --move /media/boot /sysroot/media/boot; then
    rescue_shell "Failed to move /media/boot into /sysroot/media/boot"
fi

for lower in $(echo "$LOWERS" | tr ':' ' '); do
    mkdir -p "/sysroot$lower"
    mount --move "$lower" "/sysroot$lower" || rescue_shell "Failed to retain $lower"
done
mkdir -p /sysroot/overlay_tmpfs
mount --move /overlay_tmpfs /sysroot/overlay_tmpfs || rescue_shell "Failed to retain RAM overlay"

umount /dev
umount /sys
umount /proc

echo "Switching to appliance /sbin/init..."
exec switch_root /sysroot /sbin/init
